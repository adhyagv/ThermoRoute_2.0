# Set VITE_API_URL to the deployed backend origin when building for production.
# For local development, the frontend defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Map, geocoder and route providers can be switched without source edits.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
VITE_ROUTE_DRIVING_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
VITE_ROUTE_CYCLING_URL=https://routing.openstreetmap.de/routed-bike/route/v1/driving
VITE_ROUTE_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving

# Optional OpenStreetMap Overpass API endpoint for mapped traffic controls
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
